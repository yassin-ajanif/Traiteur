<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GestionCommerciale.Modules.Location.ViewModels"
             xmlns:conv="using:GestionCommerciale.Shared.Converters"
             x:Class="GestionCommerciale.Modules.Location.Views.EtatClientView"
             x:Name="EtatClientRoot"
             x:DataType="vm:EtatClientViewModel">
  <Grid RowDefinitions="Auto,*">
    <StackPanel Spacing="8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox MinWidth="260" MaxWidth="420" VerticalAlignment="Center"
                 Watermark="{Binding SearchWatermark}" Text="{Binding SearchText}"/>
        <CheckBox Content="{Binding ChkEnRetardOnly}" IsChecked="{Binding EnRetardOnly}" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="{Binding EmptyHint}" Opacity="0.7" IsVisible="{Binding !HasClients}"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" Margin="0,8,0,0" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Clients}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="10"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:EtatClientRow">
            <Border Padding="14,12"
                    Background="{DynamicResource CourseraSurfaceBrush}"
                    BorderBrush="{DynamicResource CourseraBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
              <StackPanel Spacing="0">
                <!-- Card header -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Button Grid.Column="0" Width="28" Height="28" Padding="0" Margin="0,0,8,0"
                          Background="Transparent" BorderThickness="0"
                          Content="{Binding IsExpanded, Converter={x:Static conv:BoolToExpandArrowConverter.Instance}}"
                          Command="{Binding #EtatClientRoot.((vm:EtatClientViewModel)DataContext).ToggleExpandCommand}"
                          CommandParameter="{Binding}"
                          FontSize="12" VerticalAlignment="Top"
                          Foreground="{DynamicResource CourseraPrimaryBrush}"/>

                  <StackPanel Grid.Column="1" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding ClientNom}" FontWeight="SemiBold" FontSize="15"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                      <Border Padding="6,2" CornerRadius="4" BorderThickness="1" VerticalAlignment="Center"
                              Background="#FEE2E2" BorderBrush="#FECACA" IsVisible="{Binding EstEnRetard}">
                        <TextBlock Text="{Binding RetardBadge}" FontSize="10" FontWeight="SemiBold" Foreground="#991B1B"/>
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding ClientTelephone}" Opacity="0.75" FontSize="12"
                               IsVisible="{Binding ClientTelephone, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Text="{Binding SummaryLabel}" Opacity="0.8" FontSize="12"/>
                  </StackPanel>

                  <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right" Margin="12,0,0,0">
                    <TextBlock Text="{Binding CautionLabel}" FontWeight="SemiBold" FontSize="13"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource CourseraPrimaryBrush}"/>
                    <TextBlock Text="{Binding #EtatClientRoot.((vm:EtatClientViewModel)DataContext).ColCaution}"
                               FontSize="11" Opacity="0.65" HorizontalAlignment="Right"/>
                  </StackPanel>
                </Grid>

                <!-- Expanded lines -->
                <StackPanel IsVisible="{Binding IsExpanded}" Margin="36,12,0,0" Spacing="6">
                  <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="6"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:EtatClientItemRow">
                        <Border Padding="10,8" CornerRadius="8"
                                Background="{DynamicResource CourseraSurfaceMutedBrush}">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,10,0">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Designation}" FontWeight="SemiBold" FontSize="13"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Border Padding="6,2" CornerRadius="4" BorderThickness="1" VerticalAlignment="Center"
                                        Background="#FEE2E2" BorderBrush="#FECACA" IsVisible="{Binding EstEnRetard}">
                                  <TextBlock Text="{Binding RetardLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#991B1B"/>
                                </Border>
                              </StackPanel>
                              <TextBlock Text="{Binding MetaLabel}" FontSize="12" Opacity="0.8" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding QuantiteEncoreLabel}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center"
                                    Content="{Binding #EtatClientRoot.((vm:EtatClientViewModel)DataContext).BtnOpenLocation}"
                                    Command="{Binding #EtatClientRoot.((vm:EtatClientViewModel)DataContext).OpenLocationCommand}"
                                    CommandParameter="{Binding}"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
