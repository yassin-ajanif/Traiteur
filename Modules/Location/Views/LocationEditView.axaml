<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GestionCommerciale.Modules.Location.ViewModels"
             xmlns:m="using:GestionCommerciale.Modules.Tiers.Models"
             xmlns:cat="using:GestionCommerciale.Shared.Helpers"
             x:Class="GestionCommerciale.Modules.Location.Views.LocationEditView"
             x:Name="ThisView"
             x:DataType="vm:LocationEditViewModel">
  <ScrollViewer>
    <StackPanel Spacing="10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{Binding BtnBack}" Command="{Binding BackCommand}"/>
        <Button Content="{Binding BtnSave}" Command="{Binding SaveCommand}"/>
      </StackPanel>
      <Border Background="{DynamicResource CourseraSurfaceBrush}" CornerRadius="8,8,0,0" Padding="10,8">
        <Border.ContextMenu>
          <ContextMenu Opening="OnHeaderContextMenuOpening">
            <MenuItem Header="{Binding MenuDelete}" Command="{Binding RemoveLocationCommand}"/>
          </ContextMenu>
        </Border.ContextMenu>
        <TextBlock Text="{Binding Numero}" FontWeight="Bold"/>
      </Border>

      <Grid ColumnDefinitions="Auto,*,24,Auto,Auto" VerticalAlignment="Center">
        <TextBlock Grid.Column="0" Text="{Binding LblClient}" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,10,0"/>
        <AutoCompleteBox Grid.Column="1"
                         MinWidth="200" MaxWidth="420"
                         MinimumPrefixLength="1" MaxDropDownHeight="320"
                         Watermark="{Binding WmClientSearch}"
                         ItemsSource="{Binding Clients}"
                         ItemFilter="{Binding PartyAutocompleteFilter}"
                         SelectedItem="{Binding SelectedClient, Mode=TwoWay}"
                         VerticalAlignment="Center">
          <AutoCompleteBox.ValueMemberBinding>
            <Binding Path="Nom"/>
          </AutoCompleteBox.ValueMemberBinding>
          <AutoCompleteBox.ItemTemplate>
            <DataTemplate DataType="m:Tiers">
              <TextBlock Text="{Binding Nom}"/>
            </DataTemplate>
          </AutoCompleteBox.ItemTemplate>
        </AutoCompleteBox>
        <TextBlock Grid.Column="3" Text="{Binding LblDate}" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,10,0"/>
        <DatePicker Grid.Column="4" SelectedDate="{Binding Date}" VerticalAlignment="Center"/>
      </Grid>

      <Grid ColumnDefinitions="Auto,24,Auto,24,Auto" VerticalAlignment="Top">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="{Binding LblDateDebut}" Opacity="0.7"/>
          <DatePicker SelectedDate="{Binding DateDebut}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="4">
          <TextBlock Text="{Binding LblDateFin}" Opacity="0.7"/>
          <DatePicker SelectedDate="{Binding DateFinPrevue}"/>
        </StackPanel>
        <StackPanel Grid.Column="4" Spacing="4">
          <TextBlock Text="{Binding LblDateRetour}" Opacity="0.7"/>
          <DatePicker SelectedDate="{Binding DateRetourEffective}"/>
        </StackPanel>
      </Grid>

      <Grid ColumnDefinitions="Auto,Auto,24,Auto,140" VerticalAlignment="Center">
        <TextBlock Grid.Column="0" Text="{Binding LblStatut}" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,10,0"/>
        <Border Grid.Column="1"
                Padding="10,4"
                CornerRadius="4"
                BorderThickness="1"
                Background="{Binding StatutChipBackground}"
                BorderBrush="{Binding StatutChipBorder}"
                VerticalAlignment="Center">
          <TextBlock Text="{Binding StatutLabel}"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{Binding StatutChipForeground}"/>
        </Border>
        <TextBlock Grid.Column="3" Text="{Binding LblCaution}" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,10,0"/>
        <NumericUpDown Grid.Column="4" Value="{Binding Caution}" Minimum="0" FormatString="N2"
                       VerticalAlignment="Center"/>
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding LblAddProduct}" VerticalAlignment="Center" Opacity="0.7"/>
        <AutoCompleteBox MinWidth="360" MaxWidth="520" VerticalAlignment="Center"
                         MinimumPrefixLength="1" MaxDropDownHeight="320"
                         Watermark="{Binding WmAddProduct}"
                         ItemsSource="{Binding AddLineSearchResults}"
                         ItemFilter="{Binding CatalogAutocompleteFilter}"
                         cat:DocumentCatalogAutoComplete.ClearTextAfterPick="True"
                         Text="{Binding AddLineSearchText, Mode=TwoWay}"
                         SelectedItem="{Binding AddLineCatalogPick, Mode=TwoWay}">
          <AutoCompleteBox.ValueMemberBinding>
            <Binding Path="Reference"/>
          </AutoCompleteBox.ValueMemberBinding>
          <AutoCompleteBox.ItemTemplate>
            <DataTemplate DataType="cat:DocumentCatalogItem">
              <TextBlock TextWrapping="Wrap" Text="{Binding DisplayLabel}"/>
            </DataTemplate>
          </AutoCompleteBox.ItemTemplate>
        </AutoCompleteBox>
        <Button Content="{Binding BtnRemoveLine}" Command="{Binding RemoveSelectedLineCommand}"/>
      </StackPanel>

      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <Grid MinWidth="980" RowDefinitions="Auto,*">
          <Border Grid.Row="0" BorderBrush="{DynamicResource CourseraBorderBrush}" BorderThickness="1" CornerRadius="8,8,0,0"
                  Background="{DynamicResource CourseraSurfaceMutedBrush}" Padding="8,8">
            <Grid ColumnDefinitions="100,*,80,80,90,70,70,90,90">
              <TextBlock Grid.Column="0" Text="{Binding LblDocColRef}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="1" Text="{Binding LblDocColDesignation}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="2" Text="{Binding LblDocColQte}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="3" Text="{Binding LblDocColQteRetour}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="4" Text="{Binding LblDocColPuHt}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="5" Text="{Binding LblDocColRemise}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="6" Text="{Binding LblDocColTva}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="7" Text="{Binding LblDocColMontantHt}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="8" Text="{Binding LblDocColMontantTtc}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
          </Border>
          <ListBox Grid.Row="1" ItemsSource="{Binding Lignes}" SelectedItem="{Binding SelectedLine}" MinHeight="200"
                   BorderThickness="1" BorderBrush="{DynamicResource CourseraBorderBrush}" CornerRadius="0,0,8,8"
                   Background="{DynamicResource CourseraSurfaceBrush}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:LocationLineRow">
                <Border Padding="6,2" BorderBrush="#18000000" BorderThickness="0,0,0,1">
                  <Grid MinHeight="34" ColumnDefinitions="100,*,80,80,90,70,70,90,90">
                    <TextBlock Grid.Column="0" Text="{Binding Reference}" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
                    <TextBox Grid.Column="1" Text="{Binding Designation}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <NumericUpDown Grid.Column="2" Value="{Binding Quantite}" Minimum="0" FormatString="N2"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <NumericUpDown Grid.Column="3" Value="{Binding QuantiteRetournee}" Minimum="0" FormatString="N2"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <NumericUpDown Grid.Column="4" Value="{Binding PrixUnitaireHt}" Minimum="0" FormatString="N2"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <NumericUpDown Grid.Column="5" Value="{Binding Remise}" Minimum="0" Maximum="100" FormatString="N2"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <NumericUpDown Grid.Column="6" Value="{Binding TauxTva}" Minimum="0" FormatString="N2"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="7" Text="{Binding MontantHt, StringFormat={}{0:N2}}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="8" Text="{Binding MontantTtc, StringFormat={}{0:N2}}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" FontWeight="SemiBold"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </ScrollViewer>

      <StackPanel Orientation="Horizontal" Spacing="16">
        <TextBlock Text="{Binding LblTotals}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding TotalHtLabel}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding TotalTvaLabel}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding TotalTtcLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>

      <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Top">
        <TextBlock Grid.Column="0" Text="{Binding LblNote}" VerticalAlignment="Top" Opacity="0.7" Margin="0,6,10,0"/>
        <TextBox Grid.Column="1"
                 Text="{Binding Note}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="72"
                 MaxHeight="160"/>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
