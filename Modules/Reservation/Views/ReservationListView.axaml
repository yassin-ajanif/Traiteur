<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GestionCommerciale.Modules.Reservation.ViewModels"
             xmlns:beh="using:GestionCommerciale.Shared.Behaviors"
             xmlns:shared="using:GestionCommerciale.Shared.Views"
             x:Class="GestionCommerciale.Modules.Reservation.Views.ReservationListView"
             x:Name="ResListRoot"
             x:DataType="vm:ReservationListViewModel">
  <Grid RowDefinitions="Auto,*,Auto">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="{Binding BtnNew}" Command="{Binding NewReservationCommand}"/>
      <Button Content="{Binding BtnFilterDate}" Command="{Binding FilterDateCommand}"/>
      <TextBox MinWidth="260" MaxWidth="420" VerticalAlignment="Center"
               Watermark="{Binding SearchWatermark}" Text="{Binding SearchText}"/>
    </StackPanel>
    <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,8,0,0">
      <Border Grid.Row="0" Background="{DynamicResource CourseraSurfaceBrush}" CornerRadius="8,8,0,0" Padding="10,8" Margin="0,0,0,1">
        <Grid ColumnDefinitions="140,*,90,110,120,90,*">
          <TextBlock Grid.Column="0" Text="{Binding ColHeaderRef}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Grid.Column="1" Text="{Binding ColHeaderParty}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Grid.Column="2" Text="{Binding ColHeaderDate}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Grid.Column="3" Text="{Binding ColHeaderPeriode}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Grid.Column="4" Text="{Binding ColHeaderStatut}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Grid.Column="5" Text="{Binding ColHeaderTtc}" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="End" Margin="0,0,8,0"/>
          <TextBlock Grid.Column="6" Text="{Binding ColHeaderNote}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </Grid>
      </Border>
      <ListBox Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
               beh:ListBoxOpenOnDoubleClick.OpenCommand="{Binding OpenSelectedCommand}">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:ReservationListRow">
            <Border Padding="10,8" Background="Transparent">
              <Border.ContextMenu>
                <ContextMenu Opening="OnRowContextMenuOpening">
                  <MenuItem Header="{Binding #ResListRoot.((vm:ReservationListViewModel)DataContext).MenuDelete}"
                            Command="{Binding #ResListRoot.((vm:ReservationListViewModel)DataContext).DeleteReservationCommand}"
                            CommandParameter="{Binding}"/>
                </ContextMenu>
              </Border.ContextMenu>
              <Grid ColumnDefinitions="140,*,90,110,120,90,*">
                <TextBlock Grid.Column="0" Text="{Binding Reservation.Numero}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{Binding ClientNom}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="2" Text="{Binding DateShort}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="3" Text="{Binding PeriodeLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border Grid.Column="4"
                        Padding="8,3"
                        CornerRadius="4"
                        BorderThickness="1"
                        Background="{Binding StatutChipBackground}"
                        BorderBrush="{Binding StatutChipBorder}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="0,0,8,0">
                  <TextBlock Text="{Binding StatutLabel}"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="{Binding StatutChipForeground}"/>
                </Border>
                <TextBlock Grid.Column="5" Text="{Binding TtcLabel}" VerticalAlignment="Center" FontWeight="SemiBold" TextAlignment="End" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="6" Text="{Binding NotePreview}" VerticalAlignment="Center" Opacity="0.85" TextTrimming="CharacterEllipsis"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
    <shared:ListPaginationBar Grid.Row="2" DataContext="{Binding Pagination}"/>
  </Grid>
</UserControl>
