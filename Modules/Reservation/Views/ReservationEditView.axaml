<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GestionCommerciale.Modules.Reservation.ViewModels"
             xmlns:m="using:GestionCommerciale.Modules.Tiers.Models"
             xmlns:cat="using:GestionCommerciale.Shared.Helpers"
             x:Class="GestionCommerciale.Modules.Reservation.Views.ReservationEditView"
             x:Name="ThisView"
             x:DataType="vm:ReservationEditViewModel">
  <ScrollViewer>
    <StackPanel Spacing="10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{Binding BtnBack}" Command="{Binding BackCommand}"/>
        <Button Content="{Binding BtnSave}" Command="{Binding SaveCommand}"/>
        <Button Content="{Binding BtnToBl}" Command="{Binding ToBlCommand}"/>
      </StackPanel>
      <Border Background="{DynamicResource CourseraSurfaceBrush}" CornerRadius="8,8,0,0" Padding="10,8">
        <Border.ContextMenu>
          <ContextMenu Opening="OnHeaderContextMenuOpening">
            <MenuItem Header="{Binding MenuDelete}" Command="{Binding RemoveReservationCommand}"/>
          </ContextMenu>
        </Border.ContextMenu>
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="{Binding Numero}" FontWeight="Bold" VerticalAlignment="Center"/>
            <Border Padding="6,2"
                    Background="{DynamicResource CourseraPrimaryBrush}"
                    BorderBrush="{DynamicResource CourseraPrimaryHoverBrush}"
                    BorderThickness="1" CornerRadius="4"
                    IsVisible="{Binding HasBlLabel}" Cursor="Hand" Tapped="OnBlChipTapped" VerticalAlignment="Center">
              <TextBlock Text="{Binding BlLabel}" FontSize="11" FontWeight="Bold" Foreground="White"/>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{Binding LblStatut}" Opacity="0.7" VerticalAlignment="Center"/>
              <Border Padding="10,4"
                      CornerRadius="4"
                      BorderThickness="1"
                      Background="{Binding StatutChipBackground}"
                      BorderBrush="{Binding StatutChipBorder}"
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding StatutLabel}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{Binding StatutChipForeground}"/>
              </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{Binding LblCaution}" Opacity="0.7" VerticalAlignment="Center"/>
              <NumericUpDown Value="{Binding Caution}" Minimum="0" FormatString="N2"
                             MinWidth="110" MaxWidth="130" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="10" Margin="0,0,24,0">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="{Binding LblClient}" VerticalAlignment="Center" Opacity="0.7"/>
            <AutoCompleteBox Width="260"
                             MinimumPrefixLength="1" MaxDropDownHeight="320"
                             Watermark="{Binding WmClientSearch}"
                             ItemsSource="{Binding Clients}"
                             ItemFilter="{Binding PartyAutocompleteFilter}"
                             SelectedItem="{Binding SelectedClient, Mode=TwoWay}"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Left">
              <AutoCompleteBox.ValueMemberBinding>
                <Binding Path="Nom"/>
              </AutoCompleteBox.ValueMemberBinding>
              <AutoCompleteBox.ItemTemplate>
                <DataTemplate DataType="m:Tiers">
                  <TextBlock Text="{Binding Nom}"/>
                </DataTemplate>
              </AutoCompleteBox.ItemTemplate>
            </AutoCompleteBox>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="24">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Text="{Binding LblDateDebut}" Opacity="0.7" VerticalAlignment="Center"/>
              <CalendarDatePicker SelectedDate="{Binding DateDebut}"
                                  SelectedDateFormat="Custom"
                                  CustomDateFormatString="dd/MM/yyyy"
                                  Watermark="jj/mm/aaaa"
                                  VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Text="{Binding LblDateFin}" Opacity="0.7" VerticalAlignment="Center"/>
              <CalendarDatePicker SelectedDate="{Binding DateFinPrevue}"
                                  SelectedDateFormat="Custom"
                                  CustomDateFormatString="dd/MM/yyyy"
                                  Watermark="jj/mm/aaaa"
                                  VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="10" HorizontalAlignment="Right">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Right">
            <TextBlock Text="{Binding LblDate}" Opacity="0.7" VerticalAlignment="Center"/>
            <CalendarDatePicker SelectedDate="{Binding Date}"
                                SelectedDateFormat="Custom"
                                CustomDateFormatString="dd/MM/yyyy"
                                Watermark="jj/mm/aaaa"
                                VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Right">
            <TextBlock Text="{Binding LblDateRetour}" Opacity="0.7" VerticalAlignment="Center"/>
            <CalendarDatePicker SelectedDate="{Binding DateRetourEffective}"
                                SelectedDateFormat="Custom"
                                CustomDateFormatString="dd/MM/yyyy"
                                Watermark="jj/mm/aaaa"
                                VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding LblAddProduct}" VerticalAlignment="Center" Opacity="0.7"/>
        <AutoCompleteBox MinWidth="360" MaxWidth="520" VerticalAlignment="Center"
                         MinimumPrefixLength="1" MaxDropDownHeight="320"
                         Watermark="{Binding WmAddProduct}"
                         ItemsSource="{Binding AddLineSearchResults}"
                         ItemFilter="{Binding CatalogAutocompleteFilter}"
                         cat:DocumentCatalogAutoComplete.ClearTextAfterPick="True"
                         Text="{Binding AddLineSearchText, Mode=TwoWay}"
                         SelectedItem="{Binding AddLineCatalogPick, Mode=TwoWay}">
          <AutoCompleteBox.ValueMemberBinding>
            <Binding Path="Reference"/>
          </AutoCompleteBox.ValueMemberBinding>
          <AutoCompleteBox.ItemTemplate>
            <DataTemplate DataType="cat:DocumentCatalogItem">
              <TextBlock TextWrapping="Wrap" Text="{Binding DisplayLabel}"/>
            </DataTemplate>
          </AutoCompleteBox.ItemTemplate>
        </AutoCompleteBox>
        <Button Content="{Binding BtnRemoveLine}" Command="{Binding RemoveSelectedLineCommand}"/>
      </StackPanel>

      <TextBlock Text="{Binding LblProduitsSection}" FontWeight="SemiBold"/>

      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <Grid MinWidth="980" RowDefinitions="Auto,*">
          <Border Grid.Row="0" BorderBrush="{DynamicResource CourseraBorderBrush}" BorderThickness="1" CornerRadius="8,8,0,0"
                  Background="{DynamicResource CourseraSurfaceMutedBrush}" Padding="8,8">
            <Grid ColumnDefinitions="100,*,80,100,90,70,70,90,90">
              <TextBlock Grid.Column="0" Text="{Binding LblDocColRef}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="1" Text="{Binding LblDocColDesignation}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="2" Text="{Binding LblDocColQte}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" Foreground="{DynamicResource CourseraPrimaryBrush}"/>
              <TextBlock Grid.Column="3" Text="{Binding LblDocColQteRetour}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" Foreground="#92400E"/>
              <TextBlock Grid.Column="4" Text="{Binding LblDocColPuHt}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="5" Text="{Binding LblDocColRemise}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="6" Text="{Binding LblDocColTva}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="7" Text="{Binding LblDocColMontantHt}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="8" Text="{Binding LblDocColMontantTtc}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
          </Border>
          <ListBox Grid.Row="1" ItemsSource="{Binding ProduitLignes}" SelectedItem="{Binding SelectedProduitLine}" MinHeight="160"
                   BorderThickness="1" BorderBrush="{DynamicResource CourseraBorderBrush}" CornerRadius="0,0,8,8"
                   Background="{DynamicResource CourseraSurfaceBrush}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:ReservationProduitLineRow">
                <Border Padding="6,2" BorderBrush="#18000000" BorderThickness="0,0,0,1">
                  <Grid MinHeight="34" ColumnDefinitions="100,*,80,100,90,70,70,90,90">
                    <TextBlock Grid.Column="0" Text="{Binding Reference}" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
                    <TextBox Grid.Column="1" Text="{Binding Designation}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <NumericUpDown Grid.Column="2" Value="{Binding Quantite}" Minimum="0" FormatString="N2"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   Background="{Binding QteLoueeBackground}"
                                   BorderBrush="{Binding QteLoueeBorder}"
                                   Foreground="{Binding QteLoueeForeground}"/>
                    <Border Grid.Column="3" Padding="4,2" Margin="0,0,8,0" CornerRadius="4"
                            Background="{Binding QteRetourBackground}"
                            BorderBrush="{Binding QteRetourBorder}" BorderThickness="1"
                            VerticalAlignment="Center" HorizontalAlignment="Stretch">
                      <TextBlock Text="{Binding QuantiteRetournee, StringFormat={}{0:N2}}"
                                 HorizontalAlignment="Right"
                                 FontWeight="SemiBold"
                                 Foreground="{Binding QteRetourForeground}"/>
                    </Border>
                    <NumericUpDown Grid.Column="4" Value="{Binding PrixUnitaireHt}" Minimum="0" FormatString="N2"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <NumericUpDown Grid.Column="5" Value="{Binding Remise}" Minimum="0" Maximum="100" FormatString="N2"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <NumericUpDown Grid.Column="6" Value="{Binding TauxTva}" Minimum="0" FormatString="N2"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="7" Text="{Binding MontantHt, StringFormat={}{0:N2}}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="8" Text="{Binding MontantTtc, StringFormat={}{0:N2}}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" FontWeight="SemiBold"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </ScrollViewer>

      <TextBlock Text="{Binding LblRetoursSection}" FontWeight="SemiBold" Margin="0,4,0,0"/>
      <Border BorderBrush="{DynamicResource CourseraBorderBrush}" BorderThickness="1" CornerRadius="8"
              Background="{DynamicResource CourseraSurfaceMutedBrush}" Padding="10">
        <StackPanel Spacing="8">
          <WrapPanel Orientation="Horizontal">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,8">
              <TextBlock Text="{Binding LblDate}" VerticalAlignment="Center" Opacity="0.75"/>
              <CalendarDatePicker SelectedDate="{Binding NewRetourDate}"
                                  SelectedDateFormat="Custom" CustomDateFormatString="dd/MM/yyyy"
                                  MinWidth="130"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,8">
              <TextBlock Text="{Binding LblRetourProduit}" VerticalAlignment="Center" Opacity="0.75"/>
              <ComboBox ItemsSource="{Binding RetourProduitOptions}"
                        SelectedItem="{Binding NewRetourProduit}"
                        MinWidth="260"
                        PlaceholderText="{Binding WmRetourProduit}">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="vm:ReservationProduitLineRow">
                    <TextBlock Text="{Binding RetourOptionLabel}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,8">
              <TextBlock Text="{Binding LblRetourQte}" VerticalAlignment="Center" Opacity="0.75"/>
              <NumericUpDown Value="{Binding NewRetourQuantite}" Minimum="0" FormatString="N2" MinWidth="90"/>
              <Button Content="{Binding BtnAddRetour}" Command="{Binding AddRetourCommand}"/>
            </StackPanel>
          </WrapPanel>
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Text="{Binding LblRetourNote}" VerticalAlignment="Center" Opacity="0.75" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Text="{Binding NewRetourNote}"/>
          </Grid>

          <Grid RowDefinitions="Auto,*" MinHeight="100">
            <Border Grid.Row="0" BorderBrush="{DynamicResource CourseraBorderBrush}" BorderThickness="1" CornerRadius="8,8,0,0"
                    Background="{DynamicResource CourseraSurfaceBrush}" Padding="8,6">
              <Grid ColumnDefinitions="110,*,80,*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding LblHistColDate}" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="{Binding LblHistColProduit}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="2" Text="{Binding LblHistColQte}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="3" Text="{Binding LblHistColNote}" FontWeight="SemiBold" Margin="0,0,8,0"/>
              </Grid>
            </Border>
            <ListBox Grid.Row="1" ItemsSource="{Binding Retours}" SelectedItem="{Binding SelectedRetour}"
                     MinHeight="80" MaxHeight="200"
                     BorderThickness="1" BorderBrush="{DynamicResource CourseraBorderBrush}" CornerRadius="0,0,8,8"
                     Background="{DynamicResource CourseraSurfaceBrush}">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:ReservationRetourRow">
                  <Border Padding="6,4" BorderBrush="#18000000" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="110,*,80,*,Auto" MinHeight="28">
                      <TextBlock Grid.Column="0" Text="{Binding DateRetour, StringFormat={}{0:dd/MM/yyyy}}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding ProduitLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                      <TextBlock Grid.Column="2" Text="{Binding Quantite, StringFormat={}{0:N2}}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                      <TextBlock Grid.Column="3" Text="{Binding Note}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" Opacity="0.8"/>
                      <Button Grid.Column="4"
                              Content="{Binding #ThisView.((vm:ReservationEditViewModel)DataContext).BtnDeleteRetour}"
                              Command="{Binding #ThisView.((vm:ReservationEditViewModel)DataContext).DeleteRetourCommand}"
                              CommandParameter="{Binding}"
                              Padding="8,2" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding LblServicesSection}" FontWeight="SemiBold" Margin="0,8,0,0"/>

      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <Grid MinWidth="880" RowDefinitions="Auto,*">
          <Border Grid.Row="0" BorderBrush="{DynamicResource CourseraBorderBrush}" BorderThickness="1" CornerRadius="8,8,0,0"
                  Background="{DynamicResource CourseraSurfaceMutedBrush}" Padding="8,8">
            <Grid ColumnDefinitions="100,*,80,90,70,70,90,90">
              <TextBlock Grid.Column="0" Text="{Binding LblDocColRef}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="1" Text="{Binding LblDocColDesignation}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="2" Text="{Binding LblDocColQteService}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="3" Text="{Binding LblDocColPuHt}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="4" Text="{Binding LblDocColRemise}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="5" Text="{Binding LblDocColTva}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="6" Text="{Binding LblDocColMontantHt}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="7" Text="{Binding LblDocColMontantTtc}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
          </Border>
          <ListBox Grid.Row="1" ItemsSource="{Binding ServiceLignes}" SelectedItem="{Binding SelectedServiceLine}" MinHeight="120"
                   BorderThickness="1" BorderBrush="{DynamicResource CourseraBorderBrush}" CornerRadius="0,0,8,8"
                   Background="{DynamicResource CourseraSurfaceBrush}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:ReservationServiceLineRow">
                <Border Padding="6,2" BorderBrush="#18000000" BorderThickness="0,0,0,1">
                  <Grid MinHeight="34" ColumnDefinitions="100,*,80,90,70,70,90,90">
                    <TextBlock Grid.Column="0" Text="{Binding Reference}" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
                    <TextBox Grid.Column="1" Text="{Binding Designation}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <NumericUpDown Grid.Column="2" Value="{Binding Quantite}" Minimum="0" FormatString="N2"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <NumericUpDown Grid.Column="3" Value="{Binding PrixUnitaireHt}" Minimum="0" FormatString="N2"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <NumericUpDown Grid.Column="4" Value="{Binding Remise}" Minimum="0" Maximum="100" FormatString="N2"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <NumericUpDown Grid.Column="5" Value="{Binding TauxTva}" Minimum="0" FormatString="N2"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="6" Text="{Binding MontantHt, StringFormat={}{0:N2}}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="7" Text="{Binding MontantTtc, StringFormat={}{0:N2}}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" FontWeight="SemiBold"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </ScrollViewer>

      <StackPanel Orientation="Horizontal" Spacing="16">
        <TextBlock Text="{Binding LblTotals}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding TotalHtLabel}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding TotalTvaLabel}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding TotalTtcLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>

      <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Top">
        <TextBlock Grid.Column="0" Text="{Binding LblNote}" VerticalAlignment="Top" Opacity="0.7" Margin="0,6,10,0"/>
        <TextBox Grid.Column="1"
                 Text="{Binding Note}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="72"
                 MaxHeight="160"/>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
